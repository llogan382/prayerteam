// fallow (https://fallow.tools/docs/) for the whole monorepo: dead code,
// duplication, health and import boundaries. One config at the root; a root
// run ignores per-package configs. Rationale: docs/research/fallow-ruleset.md.
{
  // Local schema matches the installed version (root devDependency).
  "$schema": "./node_modules/fallow/schema.json",
  "minimumVersion": "3.50.0",

  // Agent tooling, not repo code. .claude/worktrees holds full repo copies,
  // which otherwise mark every finding "incomplete import graph".
  "ignorePatterns": [".claude/**", ".agents/**"],

  // cdk.json runs `node bin/app.ts`; fallow has no CDK plugin.
  "entry": ["infra/bin/app.ts"],
  // Type-level contract test, run only by `tsc` (typecheck).
  "supportEntry": ["packages/api-client/test/**/*.ts"],

  // Never imported, but needed: the mobile Playwright config starts
  // ../server/src/main.ts, so pnpm must install the server's dependencies.
  "ignoreDependencies": ["@prayerteam/server"],

  // A props interface used by an exported construct in the same file stays
  // exported (CDK idiom; un-exporting it would leak a private type).
  "ignoreExportsUsedInFile": { "type": true, "interface": true },

  // A file the parser can't read fails the run instead of silently shrinking the graph.
  "failOnParseError": true,

  // Generated by openapi-typescript: keep it in the import graph, but not in
  // clone or complexity metrics.
  "duplicates": { "ignore": ["packages/api-client/src/schema.ts"] },
  "health": { "ignore": ["packages/api-client/src/schema.ts"] },

  "rules": {
    // Static CRAP estimate until Vitest coverage is wired in; mobile has only e2e tests.
    "complexity-crap": "warn",
    // No rule packs.
    "policy-violation": "off",
    // Every fallow-ignore comment should say why.
    "require-suppression-reason": "warn"
  },

  // ADR 0001/0002/0004/0005 as import rules. One zone per workspace.
  "boundaries": {
    "zones": [
      { "name": "domain", "root": "packages/domain", "patterns": ["**"], "publicFiles": ["src/index.ts"] },
      { "name": "db", "root": "packages/db", "patterns": ["**"], "publicFiles": ["src/index.ts", "src/testing.ts"] },
      { "name": "api-client", "root": "packages/api-client", "patterns": ["**"], "publicFiles": ["src/index.ts"] },
      { "name": "server", "root": "apps/server", "patterns": ["**"] },
      { "name": "mobile", "root": "apps/mobile", "patterns": ["**"] },
      { "name": "infra", "root": "infra", "patterns": ["**"] }
    ],
    "rules": [
      { "from": "domain", "allow": [] },
      { "from": "db", "allow": ["domain"] },
      { "from": "api-client", "allow": ["domain"] },
      { "from": "server", "allow": ["domain", "db"] },
      { "from": "mobile", "allow": ["domain", "api-client"] },
      { "from": "infra", "allow": [] }
    ],
    // A new workspace must get a zone.
    "coverage": { "requireAllFiles": true }
  }
}
