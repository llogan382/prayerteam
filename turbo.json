{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "topo": {
      "dependsOn": [
        "^topo"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "export:web": {
      "outputs": [
        "dist/**"
      ],
      "dependsOn": [
        "topo"
      ]
    },
    "test:e2e": {
      "dependsOn": [
        "export:web"
      ],
      "outputs": [
        "playwright-report/**",
        "test-results/**"
      ],
      "passThroughEnv": [
        "CI"
      ]
    },
    "check-types": {
      "dependsOn": [
        "topo"
      ]
    },
    "test": {
      "dependsOn": [
        "topo"
      ]
    }
  }
}
