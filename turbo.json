{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "topo": {
      "dependsOn": [
        "^topo"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "export:web": {
      "outputs": [
        "dist/**"
      ],
      "dependsOn": [
        "topo"
      ]
    },
    "test:e2e": {
      "dependsOn": [
        "export:web"
      ],
      "outputs": [
        "playwright-report/**",
        "test-results/**"
      ],
      "passThroughEnv": [
        "CI"
      ]
    },
    "generate": {
      "dependsOn": [
        "topo"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!openapi.json"
      ],
      "outputs": [
        "openapi.json"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "topo",
        "generate"
      ]
    },
    "test": {
      "dependsOn": [
        "topo"
      ]
    },
    "synth:check": {
      "dependsOn": [
        "topo"
      ],
      "outputs": [
        "cdk.out/**"
      ]
    }
  }
}
