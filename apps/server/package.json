{
  "name": "@prayerteam/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/main.ts",
    "start": "node src/main.ts",
    "generate": "node src/generate.ts",
    "seed": "node src/seed.ts",
    "auth:generate": "auth generate --config src/auth/schema.config.ts --output .better-auth/schema.ts --yes",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/swagger": "catalog:",
    "@prayerteam/db": "workspace:*",
    "@prayerteam/domain": "workspace:*",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "fastify": "catalog:",
    "fastify-type-provider-zod": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "auth": "catalog:",
    "openapi-types": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
